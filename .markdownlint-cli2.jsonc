{
  "config": {
    "default": true,
    "MD013": {
      "line_length": 100,
      "code_blocks": false,
      "tables": false,
      "headings": false,
      "strict": false
    },
    "MD033": {
      "allowed_elements": ["PROBLEM"]
    },
    "MD041": false,
    // YAML front matter lists (targets:, scope:) use 2-space indent; not body Markdown.
    "MD007": false,
    "MD032": false
  },
  "frontMatter": "(^---\\s*$[^]*?^---\\s*$)(\\r\\n|\\r|\\n|$)"
}
